<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:allowAudioPlaybackCapture="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- UCAP as the home screen (docs/plan-m4.md, G8): offered to Android, the role taken only when the person
                 agrees to Android's question. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- UCAP as the phone app (docs/plan-m4.md, G10; spikes/m4.md, D): Android offers the phone role only to an app
             that dials (with and without a number) and shows calls itself. -->
        <activity
            android:name=".DialActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <service
            android:name=".UcapCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- The kiosk's device administrator (docs/plan-m4.md, G9): active only where an operator made UCAP the device
             owner of a dedicated device (operator.md). -->
        <receiver
            android:name=".UcapAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/ucap_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- The help alarm (docs/plan.md, S5): the full-screen alarm over the lock screen, native, outside the
             WebView. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- UnifiedPush messages through ntfy. -->
        <service android:name=".UpService" android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <!-- Signed requests that wait for a network: receipts, the alarm's answers, endpoint registrations. -->
        <service
            android:name=".OutboxJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <!-- LIVE mode (docs/plan-m2.md): the microphone while the app is not in front, with a notification that says so. -->
        <service
            android:name=".VoiceCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Reminders on the device (S6): their alarms, and setting them again after a restart. -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- UCAP as the SMS app (docs/plan-m3.md, K4): the SMS role's four parts (SMS and MMS delivery, composing for
             other apps, quick replies to a call) and the work behind them, in a process of their own (":sms"), so a crash
             there never takes the app's help with it. -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:process=":sms"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".MmsPushReceiver"
            android:exported="true"
            android:process=":sms"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".SmsComposeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <service
            android:name=".SmsRespondService"
            android:exported="true"
            android:process=":sms"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <!-- The network's reports on what UCAP sent; what the app's process asks of the SMS process; the role changing
             hands; the retries and the 15-minute look for what waits on the server. -->
        <receiver android:name=".SmsReportReceiver" android:exported="false" android:process=":sms" />
        <receiver android:name=".MmsFetchedReceiver" android:exported="false" android:process=":sms" />
        <receiver android:name=".SmsCommands" android:exported="false" android:process=":sms" />
        <receiver android:name=".SmsRoleReceiver" android:exported="true" android:process=":sms">
            <intent-filter>
                <action android:name="android.provider.action.DEFAULT_SMS_PACKAGE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".SmsJob"
            android:exported="false"
            android:process=":sms"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Previews of other apps (docs/plan-m3.md, K5): their conversation notifications, read in a process of its own
             (":previews"), so a crash there never takes the app's help with it; what the app's process asks of it, and
             its retries. Android lists the listener as "UCAP" on its notification access page. -->
        <service
            android:name=".PreviewListener"
            android:exported="true"
            android:process=":previews"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver android:name=".PreviewCommands" android:exported="false" android:process=":previews" />
        <service
            android:name=".PreviewJob"
            android:exported="false"
            android:process=":previews"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- The SMS app there is otherwise (Google Messages), by name on UCAP's SMS page: Android hides other apps from an
         app that does not say what it looks for (package visibility, Android 11+). Every SMS app writes `smsto:`. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- The apps an area can open (G8): those a launcher sees, never every installed package. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The messengers whose previews UCAP offers (K5), by name on its page: Signal, Threema, Instagram, Facebook
             Messenger, and WhatsApp's own notifications for people without the link. -->
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="ch.threema.app" />
        <package android:name="ch.threema.app.libre" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <!-- Permissions. Each one is asked for only when its feature needs it. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push-to-talk (S8): the WebView's microphone, with the platform's echo canceller. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- LIVE mode: the microphone in a foreground service, started while the app is in front (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The app lock's extra (docs/plan-m4.md, G4): Android's own prompt (fingerprint, face or the phone's PIN) before
         the unlock key signs. Without it the prompt throws a SecurityException (seen on the emulator). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The help alarm: notifications (asked for in the helper's checklist), the full-screen alarm (a user grant on
         Android 14+, a Play Console declaration), and keeping retries across a restart (JobScheduler, persisted). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- JobScheduler refuses a job that waits for a network without it (Android 14+). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Reminders at their exact time where the person allows it (Android 12+ asks; otherwise inexact alarms). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The phone fallback (A3b): asked for only when the person chose direct calls; otherwise the dialler opens. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- UCAP as the SMS app (K4): Android grants these with the SMS role, and takes them back with it (spike C). The
         address book names who wrote (never the sender's own claim). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The SMS permissions and CALL_PHONE would make telephony required: a tablet without a SIM must still get UCAP
         (SmsRole asks whether the phone has telephony). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
</manifest>
