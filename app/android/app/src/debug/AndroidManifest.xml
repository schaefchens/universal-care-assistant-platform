<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tools/android drive the push path over adb as ntfy would (DebugPushReceiver). Only the
     shell and the system hold DUMP, so no other app can send to it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.schaefchens.ucap.DEBUG_PUSH" />
                <action android:name="de.schaefchens.ucap.DEBUG_ENDPOINT" />
            </intent-filter>
        </receiver>
        <!-- MMS on the emulator (tools/dev/mms-centre.ts): its console answers "sms pdu" with OK but delivers nothing
             (emulator 37, its modem simulator), and its carrier configuration disables MMS, so its MMS service fetches
             nothing. The notification and the fetched MMS come from adb, into the same code. -->
        <receiver
            android:name=".DebugMmsReceiver"
            android:exported="true"
            android:process=":sms"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.schaefchens.ucap.DEBUG_MMS_PUSH" />
                <action android:name="de.schaefchens.ucap.DEBUG_MMS_FETCHED" />
                <action android:name="de.schaefchens.ucap.DEBUG_SELF" />
            </intent-filter>
        </receiver>
        <!-- Previews (K5): the previews process fails on purpose, for the check that help lives on. -->
        <receiver
            android:name=".DebugPreviewReceiver"
            android:exported="true"
            android:process=":previews"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.schaefchens.ucap.DEBUG_PREVIEWS_CRASH" />
            </intent-filter>
        </receiver>
    </application>
    <!-- The stand-in messenger of the emulator checks (tools/android/spikes/m3), offered as a messenger. -->
    <queries>
        <package android:name="de.schaefchens.ucap.spike.messenger" />
    </queries>
</manifest>
